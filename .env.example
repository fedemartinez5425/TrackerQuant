# Copiá este archivo a ".env" para desarrollo LOCAL.
# En Streamlit Community Cloud, estas mismas claves van en el panel de
# "Secrets" de la app (ver README → Deploy), nunca en este archivo commiteado.

# --- Storage ---
# "csv" (default local) o "gsheets" (obligatorio en producción/Cloud,
# porque el filesystem de Streamlit Cloud es efímero)
STORAGE_BACKEND=csv
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=config/service_account.json

# --- Google Drive (sincronización automática de reportes del broker) ---
DRIVE_FOLDER_ID=

# --- Data providers ---
ALPHA_VANTAGE_API_KEY=
DEFAULT_BENCHMARK=SPY
HISTORY_PERIOD=2y
PRICE_CACHE_TTL_SECONDS=900

# --- Auth ---
SESSION_TIMEOUT_MINUTES=480
COOKIE_KEY=cambiar_esta_clave_por_una_propia_larga_y_aleatoria

DEBUG=false
