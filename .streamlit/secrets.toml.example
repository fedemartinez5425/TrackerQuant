# Ejemplo de lo que va en el panel "Secrets" de Streamlit Community Cloud
# (App settings -> Secrets). NUNCA commitear este archivo con valores reales
# a GitHub -- por eso .streamlit/secrets.toml está en .gitignore.
#
# En local, si querés probar el modo "gsheets" antes de desplegar, copiá
# este archivo a .streamlit/secrets.toml y completá los valores reales.

storage_backend = "gsheets"
google_sheets_spreadsheet_id = "ID_DE_TU_PLANILLA"   # en la URL, entre /d/ y /edit
drive_folder_id = "ID_DE_TU_CARPETA_DE_DRIVE"       # en la URL, después de /folders/

# JSON completo de la cuenta de servicio de Google Cloud, pegado como tabla
# TOML (cada clave del JSON pasa a ser una clave acá abajo). Lo generás en
# Google Cloud Console -> IAM y administración -> Cuentas de servicio ->
# Claves -> Agregar clave -> JSON.
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tracker-riesgo@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# Usuarios del sistema (reemplaza a config/credentials.yaml en Cloud).
# OBLIGATORIO en Cloud: sin esta sección la app no arranca (no se usa el
# usuario por defecto en un deploy público).
# La contraseña va HASHEADA con bcrypt -- generala con:
#   python scripts/generar_credenciales.py   (te imprime este bloque listo para pegar)
[credentials.usernames.admin]
name = "Fede"
email = "vos@ejemplo.com"
password = "$2b$12$..."  # hash bcrypt, no la contraseña en texto plano

[cookie]
name = "tracker_riesgo_auth"
key = "una_clave_larga_y_aleatoria_solo_tuya"  # ej: python -c "import secrets; print(secrets.token_hex(32))"
expiry_days = 30
